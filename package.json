{
  "name": "foli-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @folijs/playground dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:packages && pnpm size",
    "test:e2e": "playwright test",
    "bench:layout": "playwright test --config playwright.bench.config.ts",
    "corpus:pages": "playwright test --config playwright.word.config.ts",
    "prepare": "node scripts/install-hooks.mjs",
    "check:packages": "publint --strict packages/core && publint --strict packages/view && publint --strict packages/react && publint --strict packages/docx",
    "size": "node scripts/size.mjs",
    "examples": "node scripts/examples.mjs && playwright test --config playwright.examples.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "^3.0.3",
    "@fontsource/tinos": "5.3.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
