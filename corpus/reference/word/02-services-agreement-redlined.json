                           "page":  1,
                           "line":  4,
                           "endPage":  1,
                           "listString":  "1.",
                           "inTable":  false
                       },
                       {
                           "text":  "The Supplier shall provide the following services (the \"Services\"):",
                           "page":  1,
                           "line":  5,
                           "endPage":  1,
                           "listString":  "1.1",
                           "inTable":  false
                       },
                       {
