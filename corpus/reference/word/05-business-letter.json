                           "listString":  "",
                           "inTable":  false
                       },
                       {
                           "text":  "Thank you for your enquiry of 4 February. We are delighted to confirm our prices for the 2026 season, which remain unchanged for all products ordered before 31 March 2026. Orders placed after that date will be charged at the new rates shown below.",
                           "page":  1,
                           "line":  7,
                           "endPage":  1,
                           "listString":  "",
                           "inTable":  false
                       },
                       {
                           "text":  "Organic green tea, 250 g\tEUR 8.40",
