                       },
                       {
                           "text":  "Executive summary",
                           "page":  3,
                           "line":  2,
                           "endPage":  3,
                           "listString":  "",
                           "inTable":  false
                       },
                       {
                           "text":  "Revenue grew by 14% compared with the same quarter last year, driven by the new distribution agreement in Spain. Operating margin improved to 11.2%.",
                           "page":  3,
                           "line":  3,
                           "endPage":  3,
                           "listString":  "",
                           "inTable":  false
                       },
                       {
                           "text":  "Revenue: EUR 48.3 million (+14%)",
                           "page":  3,
                           "line":  5,
                           "endPage":  3,
                           "listString":  "",
                           "inTable":  false
                       },
                       {
                           "text":  "Gross margin: 38.5% (+1.2 points)",
                           "page":  3,
                           "line":  6,
                           "endPage":  3,
                           "listString":  "",
                           "inTable":  false
                       },
                       {
                           "text":  "Net cash: EUR 12.1 million",
                           "page":  3,
                           "line":  7,
                           "endPage":  3,
                           "listString":  "",
                           "inTable":  false
                       },
                       {
                           "text":  "Trading performance",
                           "page":  3,
                           "line":  8,
                           "endPage":  3,
                           "listString":  "",
                           "inTable":  false
                       },
                       {
                           "text":  "Sales by region",
                           "page":  3,
                           "line":  9,
                           "endPage":  3,
                           "listString":  "",
                           "inTable":  false
                       },
                       {
                           "text":  "All regions grew in the quarter. The chart shows monthly revenue for the last six months; the strongest month was March, when the first shipments under the new agreement were invoiced. Northern Europe remained broadly flat, while Southern Europe more than offset the seasonal slowdown in the United Kingdom. The pipeline for the second quarter is in line with the budget approved in December.",
                           "page":  3,
                           "line":  10,
                           "endPage":  3,
                           "listString":  "",
                           "inTable":  false
                       },
                       {
                           "text":  "Costs",
                           "page":  3,
                           "line":  15,
                           "endPage":  3,
                           "listString":  "",
                           "inTable":  false
                       },
                       {
                           "text":  "Staff costs",
                           "page":  3,
                           "line":  16,
                           "endPage":  3,
                           "listString":  "",
                           "inTable":  false
                       },
                       {
                           "text":  "Headcount increased from 212 to 231 employees. The main hires were:",
                           "page":  3,
                           "line":  17,
                           "endPage":  3,
                           "listString":  "",
                           "inTable":  false
                       },
                       {
                           "text":  "four data engineers for the platform programme;",
                           "page":  3,
                           "line":  18,
                           "endPage":  3,
                           "listString":  "1.",
                           "inTable":  false
                       },
                       {
                           "text":  "eight warehouse staff for the Madrid hub;",
                           "page":  3,
                           "line":  19,
                           "endPage":  3,
                           "listString":  "2.",
                           "inTable":  false
                       },
                       {
                           "text":  "a Head of Compliance.",
                           "page":  3,
                           "line":  20,
                           "endPage":  3,
                           "listString":  "3.",
                           "inTable":  false
                       },
                       {
                           "text":  "Decisions requested",
                           "page":  3,
                           "line":  21,
                           "endPage":  3,
                           "listString":  "",
                           "inTable":  false
                       },
                       {
