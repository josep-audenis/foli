{
  "name": "@folijs/view",
  "version": "0.1.0",
  "description": "Framework-agnostic DOM view for the Foli document engine: rendering, input, selection, layout.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josep-audenis/foli.git",
    "directory": "packages/view"
  },
  "homepage": "https://github.com/josep-audenis/foli#readme",
  "bugs": "https://github.com/josep-audenis/foli/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@folijs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "src",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@folijs/core": "workspace:^"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
