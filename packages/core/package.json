{
  "name": "@foli/core",
  "version": "0.0.0",
  "description": "Document model, schema and validation for the Foli document engine. No DOM.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josep-audenis/foli.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/josep-audenis/foli#readme",
  "bugs": "https://github.com/josep-audenis/foli/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@foli/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.bench.*",
    "!src/testing"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "coverage": "vitest run --root ../.. --coverage.enabled --coverage.provider=v8 --coverage.include=packages/core/src/model/** --coverage.exclude=**/*.test.ts --coverage.exclude=**/*.bench.ts --coverage.thresholds.lines=95 packages/core",
    "bench": "vitest bench --run --root ../.. --reporter=verbose packages/core"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^4.10.2"
  }
}
