{
  "name": "@foli/core",
  "version": "0.0.0",
  "description": "Framework-agnostic document model, schema and extensions for the Foli document editor.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@foli/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tiptap/starter-kit": "^3.32.2"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.32.2",
    "@tiptap/pm": "^3.32.2"
  },
  "devDependencies": {
    "@tiptap/core": "^3.32.2",
    "@tiptap/pm": "^3.32.2"
  }
}
