{
  "name": "@folijs/agent",
  "version": "0.2.0",
  "description": "Agent editing for the Foli document engine: an LLM reads a document as text with a handle per block and edits it with a few coarse operations, every edit a tracked change. No DOM, no Node built-ins.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josep-audenis/foli.git",
    "directory": "packages/agent"
  },
  "homepage": "https://github.com/josep-audenis/foli#readme",
  "bugs": "https://github.com/josep-audenis/foli/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@folijs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "src",
    "!src/**/*.test.*",
    "!src/testing"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@folijs/core": "workspace:*"
  },
  "devDependencies": {
    "@folijs/core": "workspace:*",
    "@folijs/docx": "workspace:*",
    "@types/node": "^20.19.43",
    "fast-check": "^4.10.2"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
