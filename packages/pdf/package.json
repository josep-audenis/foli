{
  "name": "@folijs/pdf",
  "version": "1.8.0",
  "description": "PDF for the Foli document engine: a document printed by a headless Chromium page the app supplies (Playwright or Puppeteer), from Foli's own page layout, fields updated, links and the outline kept.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josep-audenis/foli.git",
    "directory": "packages/pdf"
  },
  "homepage": "https://github.com/josep-audenis/foli#readme",
  "bugs": "https://github.com/josep-audenis/foli/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "@folijs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@folijs/core": "workspace:*"
  },
  "devDependencies": {
    "@folijs/core": "workspace:*",
    "@folijs/view": "workspace:*",
    "@types/node": "^20.19.43",
    "vite": "^8.3.5"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
